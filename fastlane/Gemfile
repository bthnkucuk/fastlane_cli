# frozen_string_literal: true
#
# Slim Gemfile for storepilot_bridge.rb only.
#
# Lanes (Fastfile, ios/Fastfile, android/Fastfile) DO NOT use this bundle —
# they run against the system / brew-installed `fastlane` gem.
#
# This Gemfile exists for the bridge process (`bundle exec ruby
# storepilot_bridge.rb`), which needs Google auth + Play API client to talk
# to Play Developer Reporting. `spaceship` / `supply` (used by the bridge as
# well) are loaded from the system `fastlane` gem at require-time.
#
# Bundle install location is NOT this directory — the Dart CLI sets
# BUNDLE_PATH to a user-level cache (see lib/src/services/bundle_cache.dart
# and ROADMAP §2). Do not commit a `vendor/bundle` next to this file.

source "https://rubygems.org"

gem "googleauth"
gem "google-apis-androidpublisher_v3"
