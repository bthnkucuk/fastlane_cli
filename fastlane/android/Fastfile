require_relative "../common_helpers"
require_relative "../play_setup_helpers"

# ---------------------------------------------------------------------------
# Play Console "Set up your app" lanes — option / env surface
# ---------------------------------------------------------------------------
# Contact details (store_setup / update_app_details), per-field precedence
# option → env → file at the metadata ROOT (supply ignores root-level files):
#   contact_email    | ANDROID_CONTACT_EMAIL    | <metadata>/contactEmail.txt
#   contact_phone    | ANDROID_CONTACT_PHONE    | <metadata>/contactPhone.txt
#   contact_website  | ANDROID_CONTACT_WEBSITE  | <metadata>/contactWebsite.txt
#   default_language | ANDROID_DEFAULT_LANGUAGE | <metadata>/defaultLanguage.txt
# Data safety CSV (store_setup / upload_data_safety):
#   data_safety_csv_path | ANDROID_DATA_SAFETY_CSV_PATH |
#   app <fastlane>/android/data_safety.csv → CLI android/defaults/data_safety.csv
# Composite gates (store_setup only, all default true):
#   include_listing / include_contact_details / include_data_safety
# Edit-commit behaviour (contact details): validate_only (default false),
#   changes_not_sent_for_review (default false),
#   rescue_changes_not_sent_for_review (default true).

platform :android do
  private_lane :android_package_name do |options|
    FastlaneCliConfig.resolve_identifier(options, platform: :android)
  end

  private_lane :android_version_track do |options|
    (options[:track] || ENV["ANDROID_VERSION_TRACK"] || "internal").to_s
  end

  private_lane :pubspec_version_info do |options|
    pubspec_path = FastlaneCliConfig.resolve_pubspec_path(options)
    content = File.read(pubspec_path)
    match = content.match(/version:\s*(\d+\.\d+\.\d+)\+(\d+)/)
    UI.user_error!("Could not parse version from #{pubspec_path}") unless match

    {
      pubspec_path: pubspec_path,
      version_name: match[1],
      version_code: match[2].to_i
    }
  end

  desc "Get next version code from Google Play Console"
  private_lane :get_next_version_code do |options|
    package_name = android_package_name(options)
    primary_track = android_version_track(options)
    fallback_track = (options[:fallback_track] || ENV["ANDROID_FALLBACK_TRACK"] || "production").to_s
    json_key = FastlaneCliConfig.absolute_json_key(options)

    primary_codes = google_play_track_version_codes(
      package_name: package_name,
      track: primary_track,
      json_key: json_key
    )
    latest_code = Array(primary_codes).map(&:to_i).max || 0

    if latest_code == 0 && !fallback_track.empty? && fallback_track != primary_track
      fallback_codes = google_play_track_version_codes(
        package_name: package_name,
        track: fallback_track,
        json_key: json_key
      )
      latest_code = [latest_code, Array(fallback_codes).map(&:to_i).max || 0].max
    end

    next_code = latest_code + 1
    UI.message("📱 Current version code (#{primary_track}): #{latest_code}")
    UI.message("🚀 Next version code: #{next_code}")
    next_code
  end

  desc "Update pubspec.yaml version code manually (Android-scoped)"
  private_lane :update_pubspec_version do |options|
    version_code = options[:version_code].to_i
    UI.user_error!("version_code is required") if version_code <= 0

    info = pubspec_version_info(options)
    new_version = "#{info[:version_name]}+#{version_code}"

    updated_content = File.read(info[:pubspec_path]).gsub(
      /version:\s*\d+\.\d+\.\d+\+\d+/,
      "version: #{new_version}"
    )
    File.write(info[:pubspec_path], updated_content)

    UI.success(
      "📝 Updated #{info[:pubspec_path]}: #{info[:version_name]}+#{info[:version_code]} → #{new_version}"
    )

    FastlaneCliConfig.print_summary_box(
      "Pubspec versionCode güncellendi (Android)",
      [
        "Dosya     : #{info[:pubspec_path]}",
        "Önceki    : #{info[:version_name]}+#{info[:version_code]}",
        "Yeni      : #{new_version}",
        "Kural     : versionName aynı kalır, versionCode = caller'dan gelen #{version_code} (genellikle Play Store'dan +1).",
        "Yazım     : pubspec.yaml içinde 'version: X.Y.Z+N' satırı regex ile değiştirildi."
      ]
    )

    {
      version_name: info[:version_name],
      version_code: version_code,
      full_version: new_version
    }
  end

  # Upload native (NDK) symbol files to Firebase Crashlytics so native
  # crashes (Rust/C/C++ plugins) are symbolicated. Returns a summary-box
  # marker string describing what happened — NEVER raises.
  #
  # Mirrors the iOS `test_flight` `upload_symbols` philosophy: this is a
  # soft, opt-in, never-hard-fail step. If `upload_symbols` is false the
  # marker is "atlandı". If the gradle task is absent (the consumer app has
  # not applied the Crashlytics plugin / `nativeSymbolUploadEnabled` is off /
  # the app has no native code) the gradle invocation errors — we catch it
  # and return a soft-skip marker so the AAB build+upload still succeeds.
  #
  # R8/Kotlin mapping files need nothing here: the Firebase Crashlytics
  # Gradle plugin uploads those automatically during the release build.
  private_lane :upload_crashlytics_ndk_symbols do |options|
    unless FastlaneCliConfig.bool_option(options, :upload_symbols, default: false)
      next "atlandı"
    end

    flavor = FastlaneCliConfig.resolve_flavor(options)
    task = FastlaneCliConfig.crashlytics_symbol_task(flavor: flavor, build_type: "release")
    gradle_cmd = "./android/gradlew -p android :app:#{task} --stacktrace"

    begin
      FastlaneCliConfig.with_clean_subprocess_env do
        sh(FastlaneCliConfig.in_app_root(gradle_cmd, options))
      end
      UI.success("✅ Crashlytics NDK symbols uploaded via #{task}")
      "yüklendi (#{task})"
    rescue => e
      UI.important(
        "⚠️ Crashlytics NDK symbol upload skipped: #{task} failed " \
        "(#{e.message.to_s.lines.first.to_s.strip}). " \
        "App likely has no native code or nativeSymbolUploadEnabled is off."
      )
      "atlandı (uploadCrashlyticsSymbolFile task yok / nativeSymbolUploadEnabled kapalı)"
    end
  end

  desc "Build and distribute Android app to Firebase App Distribution"
  lane :firebase_distribute do |options|
    flutter_cmd = FastlaneCliConfig.flutter_command(options)
    build_type = (options[:build_type] || "release").to_s
    flavor = FastlaneCliConfig.resolve_flavor(options)
    groups = options[:groups] || ENV["FIREBASE_ANDROID_GROUPS"] || "internal-testers"
    release_notes = options[:release_notes] || "New beta build"
    apk_path = FastlaneCliConfig.resolve_app_path(
      options[:apk_path] || "build/app/outputs/flutter-apk/app-#{build_type}.apk",
      options
    )

    auto_version = FastlaneCliConfig.bool_option(options, :auto_version, default: true)
    if auto_version
      begin
        next_code = get_next_version_code(options)
        update_pubspec_version(options.merge(version_code: next_code))
      rescue => e
        UI.important("⚠️ Auto-versioning failed: #{e.message}. Continuing.")
      end
    end

    sh(FastlaneCliConfig.in_app_root("#{flutter_cmd} clean", options))
    sh(FastlaneCliConfig.in_app_root("#{flutter_cmd} pub get", options))

    build_parts = ["#{flutter_cmd} build apk --#{build_type}"]
    build_parts << "--flavor #{Shellwords.escape(flavor)}" unless FastlaneCliConfig.blank?(flavor)
    build_parts.concat(FastlaneCliConfig.flutter_build_flags(options, artifact: :apk))
    sh(FastlaneCliConfig.in_app_root(build_parts.join(" "), options))

    firebase_app_distribution(
      app: options[:firebase_app_id] || ENV["FIREBASE_APP_ID_ANDROID"],
      apk_path: apk_path,
      release_notes: release_notes,
      groups: groups,
      firebase_cli_token: options[:firebase_cli_token] || ENV["FIREBASE_CLI_TOKEN"],
      debug: true
    )

    FastlaneCliConfig.print_summary_box(
      "Android · Firebase App Distribution",
      [
        "Flavor       : #{flavor || '(none)'}",
        "Build type   : #{build_type}",
        "APK          : #{apk_path}",
        "Groups       : #{groups}",
        "Auto version : #{auto_version}",
        "Firebase app : #{options[:firebase_app_id] || ENV['FIREBASE_APP_ID_ANDROID'] || '(env yok)'}"
      ]
    )
  end

  desc "Build and deploy Android app to Google Play internal testing"
  lane :internal_testing do |options|
    package_name = android_package_name(options)
    flutter_cmd = FastlaneCliConfig.flutter_command(options)
    flavor = FastlaneCliConfig.resolve_flavor(options)
    track = (options[:track] || ENV["ANDROID_INTERNAL_TRACK"] || "internal").to_s
    release_status = (options[:release_status] || "completed").to_s
    aab_path = FastlaneCliConfig.android_aab_path(options)

    build_parts = ["#{flutter_cmd} build appbundle --release"]
    build_parts << "--flavor #{Shellwords.escape(flavor)}" unless FastlaneCliConfig.blank?(flavor)
    target = FastlaneCliConfig.flutter_target(options)
    build_parts << "--target #{Shellwords.escape(target)}" unless FastlaneCliConfig.blank?(target)
    build_parts.concat(FastlaneCliConfig.flutter_build_flags(options, artifact: :appbundle))
    sh(FastlaneCliConfig.in_app_root(build_parts.join(" "), options))

    upload_to_play_store(
      track: track,
      aab: aab_path,
      release_status: release_status,
      json_key: FastlaneCliConfig.absolute_json_key(options),
      package_name: package_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )

    symbols_status = upload_crashlytics_ndk_symbols(options)
    flutter_symbols_status = FastlaneCliConfig.upload_flutter_symbols(options, platform: :android)

    FastlaneCliConfig.print_summary_box(
      "Android · Internal Testing yüklendi",
      [
        "Package        : #{package_name}",
        "Flavor         : #{flavor || '(none)'}",
        "Track          : #{track}",
        "Release status : #{release_status}",
        "AAB            : #{aab_path}",
        "NDK symbols    : #{symbols_status}",
        "Dart symbols   : #{flutter_symbols_status}"
      ]
    )
  end

  desc "Build and deploy Android app to Google Play production"
  lane :production do |options|
    package_name = android_package_name(options)
    flutter_cmd = FastlaneCliConfig.flutter_command(options)
    flavor = FastlaneCliConfig.resolve_flavor(options)
    track = (options[:track] || "production").to_s
    release_status = (options[:release_status] || "draft").to_s
    aab_path = FastlaneCliConfig.android_aab_path(options)

    auto_version = FastlaneCliConfig.bool_option(options, :auto_version, default: true)
    if auto_version
      next_code = get_next_version_code(options.merge(track: track))
      update_pubspec_version(options.merge(version_code: next_code))
    end

    build_parts = ["#{flutter_cmd} build appbundle --release"]
    build_parts << "--flavor #{Shellwords.escape(flavor)}" unless FastlaneCliConfig.blank?(flavor)
    target = FastlaneCliConfig.flutter_target(options)
    build_parts << "--target #{Shellwords.escape(target)}" unless FastlaneCliConfig.blank?(target)
    build_parts.concat(FastlaneCliConfig.flutter_build_flags(options, artifact: :appbundle))
    sh(FastlaneCliConfig.in_app_root(build_parts.join(" "), options))

    upload_to_play_store(
      track: track,
      aab: aab_path,
      release_status: release_status,
      json_key: FastlaneCliConfig.absolute_json_key(options),
      package_name: package_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )

    symbols_status = upload_crashlytics_ndk_symbols(options)
    flutter_symbols_status = FastlaneCliConfig.upload_flutter_symbols(options, platform: :android)

    FastlaneCliConfig.print_summary_box(
      "Android · Production yüklendi",
      [
        "Package        : #{package_name}",
        "Flavor         : #{flavor || '(none)'}",
        "Track          : #{track}",
        "Release status : #{release_status}",
        "Auto version   : #{auto_version}",
        "AAB            : #{aab_path}",
        "NDK symbols    : #{symbols_status}",
        "Dart symbols   : #{flutter_symbols_status}"
      ]
    )
  end

  desc "Build APK for local testing"
  lane :build_apk do |options|
    flutter_cmd = FastlaneCliConfig.flutter_command(options)
    build_type = (options[:build_type] || "release").to_s
    flavor = FastlaneCliConfig.resolve_flavor(options)

    sh(FastlaneCliConfig.in_app_root("#{flutter_cmd} clean", options))
    sh(FastlaneCliConfig.in_app_root("#{flutter_cmd} pub get", options))

    build_parts = ["#{flutter_cmd} build apk --#{build_type}"]
    build_parts << "--flavor #{Shellwords.escape(flavor)}" unless FastlaneCliConfig.blank?(flavor)
    target = FastlaneCliConfig.flutter_target(options)
    build_parts << "--target #{Shellwords.escape(target)}" unless FastlaneCliConfig.blank?(target)
    build_parts.concat(FastlaneCliConfig.flutter_build_flags(options, artifact: :apk))
    sh(FastlaneCliConfig.in_app_root(build_parts.join(" "), options))

    expected_apk = FastlaneCliConfig.resolve_app_path(
      "build/app/outputs/flutter-apk/app-#{build_type}.apk", options
    )
    FastlaneCliConfig.print_summary_box(
      "Android · APK build tamamlandı",
      [
        "Flavor       : #{flavor || '(none)'}",
        "Build type   : #{build_type}",
        "Target       : #{target || '(varsayılan)'}",
        "Beklenen APK : #{expected_apk}"
      ]
    )
  end

  desc "Increment version code manually"
  lane :increment_version do |options|
    next_code = get_next_version_code(options)
    update_pubspec_version(options.merge(version_code: next_code))
  end

  desc "Check current version status"
  lane :version_status do |options|
    info = pubspec_version_info(options)
    UI.message("📱 Current local version: #{info[:version_name]}+#{info[:version_code]}")

    remote_label = "(alınamadı)"
    state_label = "?"
    begin
      latest_remote = get_next_version_code(options) - 1
      remote_label = latest_remote.to_s
      UI.message("🏪 Latest Play Store version code: #{latest_remote}")
      if info[:version_code] > latest_remote
        state_label = "✅ Local Play Store'un önünde"
        UI.success("✅ Local version is ahead of Play Store.")
      elsif info[:version_code] == latest_remote
        state_label = "⚠️ Local Play Store ile aynı; artırım gerekli"
        UI.important("⚠️ Local version matches Play Store; increment needed.")
      else
        state_label = "❌ Local Play Store'un gerisinde"
        UI.error("❌ Local version is behind Play Store.")
      end
    rescue => e
      state_label = "❌ Play Store sorgulanamadı: #{e.message}"
      UI.error("❌ Could not fetch Play Store version: #{e.message}")
    end

    FastlaneCliConfig.print_summary_box(
      "Android · Version status",
      [
        "Pubspec yolu      : #{info[:pubspec_path]}",
        "Local versionName : #{info[:version_name]}",
        "Local versionCode : #{info[:version_code]}",
        "Play Store code   : #{remote_label}",
        "Durum             : #{state_label}"
      ]
    )
  end

  desc "Print latest Google Play version and build number as version|buildnumber"
  lane :get_android_version_data do |options|
    package_name = android_package_name(options)
    track = android_version_track(options)
    json_key = FastlaneCliConfig.absolute_json_key(options)

    semver_prefix = /\b(\d+\.\d+\.\d+)\b/
    semver_key = ->(name) { name.to_s.split(".").map(&:to_i) }
    extract_semver = ->(value) {
      match = value.to_s.strip.match(semver_prefix)
      match && match[1]
    }

    latest_code = 0
    version_name = ""

    # Preferred path: pull the full release info so we can pair the highest
    # version_code with its release name reliably. Falls back to the two
    # separate stock actions if anything goes wrong.
    begin
      releases = google_play_track_releases(
        package_name: package_name,
        track: track,
        json_key: json_key
      )

      pairs = Array(releases).map do |release|
        name = release[:name] || release["name"]
        codes = release[:version_codes] || release["version_codes"]
        max_code = Array(codes).map(&:to_i).max || 0
        [extract_semver.call(name), max_code]
      end.reject { |(_, code)| code <= 0 }

      unless pairs.empty?
        best_by_code = pairs.max_by { |(_, code)| code }
        latest_code = best_by_code[1]
        version_name = best_by_code[0].to_s
      end
    rescue => e
      UI.important("⚠️ google_play_track_releases failed: #{e.message}")
    end

    if latest_code == 0
      version_codes = google_play_track_version_codes(
        package_name: package_name,
        track: track,
        json_key: json_key
      )
      latest_code = Array(version_codes).map(&:to_i).max || 0
    end

    if version_name.empty?
      release_names = google_play_track_release_names(
        package_name: package_name,
        track: track,
        json_key: json_key
      )
      candidates = Array(release_names).map(&extract_semver).compact
      version_name = candidates.sort_by(&semver_key).last.to_s
    end

    version_name = "unknown" if version_name.empty?

    output = "#{version_name}|#{latest_code}"

    FastlaneCliConfig.print_summary_box(
      "Android · Play Store version data",
      [
        "Package      : #{package_name}",
        "Track        : #{track}",
        "JSON key     : #{json_key}",
        "versionName  : #{version_name}",
        "versionCode  : #{latest_code}",
        "Kaynak       : google_play_track_releases (fallback: track_version_codes + track_release_names)"
      ]
    )

    puts output
    puts "[VERSION_DATA] #{output}"
    output
  end

  desc "Instructions for fixing Google Play Console issues"
  lane :google_play_help do
    UI.message("🔧 Google Play Console Common Issues & Solutions")
    UI.message("1) Foreground service permissions → Play Console > App content")
    UI.message("2) Release not found → publish draft release in internal testing")
    UI.message("3) Version code already exists → run fastlane android version_status")
    UI.message("4) Service account permissions → Play Console > API access")
  end

  desc "Upload Android Play Store metadata (optionally images/screenshots/changelogs)"
  lane :update_metadata do |options|
    package_name = android_package_name(options)
    track = (options[:track] || "alpha").to_s
    metadata_path = FastlaneCliConfig.resolve_path_in_fastlane(
      options: options,
      option_key: :metadata_path,
      env_keys: %w[ANDROID_METADATA_PATH FASTLANE_ANDROID_METADATA_PATH],
      default_relative: "android/metadata"
    )
    FileUtils.mkdir_p(metadata_path)

    include_images = FastlaneCliConfig.bool_option(options, :include_images, default: false)
    include_screenshots = FastlaneCliConfig.bool_option(options, :include_screenshots, default: false)
    include_changelogs = FastlaneCliConfig.bool_option(options, :include_changelogs, default: false)

    # version_code is only needed when uploading changelogs — supply uses it to
    # locate the matching Play Console release. When changelogs are skipped,
    # passing version_code makes supply hard-fail if the release does not yet
    # exist (e.g. metadata-only run before a build is uploaded).
    version_code = nil
    if include_changelogs
      version_code = options[:version_code]
      version_code ||= pubspec_version_info(options)[:version_code]
    end

    supply_params = {
      package_name: package_name,
      track: track,
      metadata_path: metadata_path,
      json_key: FastlaneCliConfig.absolute_json_key(options),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: !include_changelogs,
      skip_upload_images: !include_images,
      skip_upload_screenshots: !include_screenshots
    }
    supply_params[:version_code] = version_code unless version_code.nil?

    supply(**supply_params)

    locales = []
    if Dir.exist?(metadata_path)
      locales = Dir.children(metadata_path).select do |entry|
        File.directory?(File.join(metadata_path, entry)) && !entry.start_with?(".")
      end.sort
    end

    FastlaneCliConfig.print_summary_box(
      "Android · Play Store metadata yüklendi",
      [
        "Package             : #{package_name}",
        "Track               : #{track}",
        "Metadata path       : #{metadata_path}",
        "Locales             : #{locales.empty? ? '(none)' : locales.join(', ')}",
        "Include images      : #{include_images}",
        "Include screenshots : #{include_screenshots}",
        "Include changelogs  : #{include_changelogs}",
        "Version code        : #{version_code || '(skipped)'}"
      ]
    )
  end

  desc "Download Android Play Store listing assets (metadata, screenshots, changelogs)"
  lane :download_store_listing do |options|
    package_name = android_package_name(options)
    track = (options[:track] || "internal").to_s
    metadata_path = FastlaneCliConfig.resolve_path_in_fastlane(
      options: options,
      option_key: :metadata_path,
      env_keys: %w[ANDROID_METADATA_PATH FASTLANE_ANDROID_METADATA_PATH],
      default_relative: "android/metadata"
    )
    FileUtils.mkdir_p(metadata_path)

    download_options = {
      package_name: package_name,
      track: track,
      metadata_path: metadata_path,
      json_key: FastlaneCliConfig.absolute_json_key(options)
    }

    version_name = options[:version_name].to_s.strip
    download_options[:version_name] = version_name unless version_name.empty?

    download_from_play_store(**download_options)
    UI.success("✅ Play Store listing downloaded to #{metadata_path}")

    # Contact-details pull: read-mode google_play_app_details (no setter
    # fields → pure GET, edit aborted) → contactEmail.txt & friends at the
    # metadata root. Best-effort: a failure here must NEVER break the
    # listing download that already succeeded.
    contact_status = "atlandı"
    begin
      details_result = google_play_app_details(
        package_name: package_name,
        json_key: FastlaneCliConfig.absolute_json_key(options)
      )
      written = PlaySetupHelpers.write_contact_files(
        metadata_path: metadata_path,
        details: details_result[:current_values] || {}
      )
      contact_status =
        if written.empty?
          "atlandı (Play'de iletişim bilgisi yok)"
        else
          "indirildi (#{written.join(', ')})"
        end
    rescue => e
      reason = e.message.to_s.lines.first.to_s.strip
      UI.important("⚠️ Contact-details pull skipped: #{reason}")
      contact_status = "atlandı (#{reason})"
    end

    locales = []
    if Dir.exist?(metadata_path)
      locales = Dir.children(metadata_path).select do |entry|
        File.directory?(File.join(metadata_path, entry)) && !entry.start_with?(".")
      end.sort
    end

    FastlaneCliConfig.print_summary_box(
      "Android · Play Store listing indirildi",
      [
        "Package       : #{package_name}",
        "Track         : #{track}",
        "Output path   : #{metadata_path}",
        "Locales       : #{locales.empty? ? '(none)' : locales.join(', ')}",
        "Version name  : #{version_name.empty? ? '(latest)' : version_name}",
        "Contact files : #{contact_status}"
      ]
    )
  end

  # Shared google_play_app_details invocation for `update_app_details` and
  # `store_setup`. Expects the caller to have merged the RESOLVED contact
  # details (PlaySetupHelpers.resolve_contact_details output) into the
  # options under :resolved_details and the resolved package under
  # :package_name.
  private_lane :push_play_contact_details do |options|
    details = options[:resolved_details]

    google_play_app_details(
      package_name: options[:package_name],
      json_key: FastlaneCliConfig.absolute_json_key(options),
      contact_email: details[:contact_email][:value],
      contact_phone: details[:contact_phone][:value],
      contact_website: details[:contact_website][:value],
      default_language: details[:default_language][:value],
      validate_only: FastlaneCliConfig.bool_option(options, :validate_only, default: false),
      changes_not_sent_for_review: FastlaneCliConfig.bool_option(
        options, :changes_not_sent_for_review, default: false
      ),
      rescue_changes_not_sent_for_review: FastlaneCliConfig.bool_option(
        options, :rescue_changes_not_sent_for_review, default: true
      )
    )
  end

  desc "Update Play Console contact details (email/phone/website, default language)"
  lane :update_app_details do |options|
    package_name = android_package_name(options)
    metadata_path = FastlaneCliConfig.absolute_metadata_path(options, platform: :android)
    details = PlaySetupHelpers.resolve_contact_details(options, metadata_path: metadata_path)

    # Standalone lane → hard-fail when nothing resolves (a no-op contact
    # update is useless; mirrors upload_dsyms' philosophy).
    unless PlaySetupHelpers.any_contact_value?(details)
      UI.user_error!(
        "No contact details resolved. Provide contact_email/contact_phone/" \
        "contact_website/default_language options, set the ANDROID_CONTACT_* / " \
        "ANDROID_DEFAULT_LANGUAGE env vars, or place " \
        "#{PlaySetupHelpers::CONTACT_FILES.values.join(' / ')} at the metadata " \
        "root (#{metadata_path})."
      )
    end

    result = push_play_contact_details(
      options.merge(resolved_details: details, package_name: package_name)
    )

    field_lines = PlaySetupHelpers::CONTACT_FIELDS.map do |field|
      entry = details[field]
      value_label = entry[:value] || "(yok — dokunulmadı)"
      source_label = entry[:source] ? "  ← #{entry[:source]}" : ""
      format("%-17s: %s%s", field, value_label, source_label)
    end
    changes = result[:changes] || {}

    FastlaneCliConfig.print_summary_box(
      "Android · Play Console iletişim bilgileri",
      [
        "Package          : #{package_name}",
        "Metadata root    : #{metadata_path}",
        :sep,
        *field_lines,
        :sep,
        "Değişen alanlar  : #{changes.empty? ? '(yok — Play zaten güncel)' : changes.keys.join(', ')}",
        "Mod              : #{result[:mode]}",
        "Kaynak sırası    : option → ANDROID_CONTACT_* env → metadata kökü dosyaları"
      ]
    )
  end

  desc "Upload (REPLACE) the Play Console Data safety form from CSV"
  lane :upload_data_safety do |options|
    package_name = android_package_name(options)
    csv = PlaySetupHelpers.resolve_data_safety_csv_path(
      options,
      fastlane_root: FastlaneCliConfig.resolve_fastlane_root(options),
      runner_root: FastlaneCliConfig.resolve_runner_fastlane_path(options),
      base_dir: FastlaneCliConfig.resolve_app_root(options)
    )

    # A CSV path normally always resolves (the CLI ships a default template);
    # a nil path means even the bundled default is absent.
    if csv[:path].nil?
      UI.user_error!(
        "No Data safety CSV resolved — even the CLI default template " \
        "(#{PlaySetupHelpers::DATA_SAFETY_DEFAULT_RELATIVE}) is missing. " \
        "Provide data_safety_csv_path, set #{PlaySetupHelpers::DATA_SAFETY_ENV}, or " \
        "place #{PlaySetupHelpers::DATA_SAFETY_APP_RELATIVE} in the app's fastlane folder."
      )
    end

    # The generic CLI-default template is OPT-IN only. It is a generic
    # reference the user is expected to replace — Google rejects it (400)
    # and pushing it would overwrite a hand-filled form with generic
    # answers. Refuse it unless the caller knowingly opts in with
    # data_safety_allow_default:true. A user-provided CSV (option / env /
    # app override) always proceeds.
    allow_default = FastlaneCliConfig.bool_option(options, :data_safety_allow_default, default: false)
    if !PlaySetupHelpers.user_provided_csv?(csv[:source]) && !allow_default
      UI.user_error!(
        "Refusing to upload the generic CLI-default Data safety template " \
        "(#{csv[:source]}). Export your own form from Play Console → App content → " \
        "Data safety → Export and place it at " \
        "<fastlane_root>/#{PlaySetupHelpers::DATA_SAFETY_APP_RELATIVE} (or set " \
        "#{PlaySetupHelpers::DATA_SAFETY_ENV} / pass data_safety_csv_path). To knowingly " \
        "upload the bundled reference template anyway, pass data_safety_allow_default:true."
      )
    end

    stats = google_play_data_safety(
      package_name: package_name,
      json_key: FastlaneCliConfig.absolute_json_key(options),
      csv_path: csv[:path]
    )

    FastlaneCliConfig.print_summary_box(
      "Android · Data safety formu yüklendi",
      [
        "Package     : #{package_name}",
        "CSV         : #{csv[:path]}",
        "CSV kaynağı : #{csv[:source]}",
        "Boyut       : #{stats[:lines]} satır / #{stats[:bytes]} bayt",
        :sep,
        "UYARI: Play Console'daki Data safety formu TAMAMEN bu CSV ile değiştirilir",
        "(API'nin okuma ucu yok — geri çekilemez). Veri pratikleri farklıysa kendi",
        "Console export'unuzu #{PlaySetupHelpers::DATA_SAFETY_APP_RELATIVE} olarak koyun;",
        "app override her zaman CLI default şablonunu ezer."
      ]
    )
  end

  desc "Play Console 'Set up your app': listing + contact details + Data safety"
  lane :store_setup do |options|
    package_name = android_package_name(options)
    metadata_path = FastlaneCliConfig.absolute_metadata_path(options, platform: :android)
    step_errors = []
    first_line = ->(error) { error.message.to_s.lines.first.to_s.strip }

    # ① Store listing — delegate in-process to update_metadata when the
    # metadata dir actually has locale directories; otherwise soft-skip.
    listing_status =
      if !FastlaneCliConfig.bool_option(options, :include_listing, default: true)
        "atlandı (include_listing=false)"
      else
        locales = []
        if Dir.exist?(metadata_path)
          locales = Dir.children(metadata_path).select do |entry|
            File.directory?(File.join(metadata_path, entry)) && !entry.start_with?(".")
          end.sort
        end

        if locales.empty?
          "atlandı (metadata dizininde locale klasörü yok: #{metadata_path})"
        else
          begin
            update_metadata(options)
            "yüklendi (#{locales.join(', ')})"
          rescue => e
            # A brand-new app / track has no release yet, so supply rejects
            # the image/screenshot push with a "release/track not ready"
            # error even with changelog upload skipped. For a *setup* lane
            # that is a normal "not ready yet" condition — soft-skip instead
            # of hard-failing (the listing rides along with the first release
            # once a build is uploaded). Any OTHER error is a real failure.
            if PlaySetupHelpers.listing_not_ready_error?(e.message)
              "atlandı (track'te henüz release yok — önce bir build yükleyin; " \
                "listing ilk sürümle birlikte gönderilir)"
            else
              step_errors << "listing: #{first_line.call(e)}"
              "hata (#{first_line.call(e)})"
            end
          end
        end
      end

    # ② Contact details — only attempted when at least one field resolves.
    details = PlaySetupHelpers.resolve_contact_details(options, metadata_path: metadata_path)
    contact_status =
      if !FastlaneCliConfig.bool_option(options, :include_contact_details, default: true)
        "atlandı (include_contact_details=false)"
      elsif !PlaySetupHelpers.any_contact_value?(details)
        "atlandı (option/env/#{PlaySetupHelpers::CONTACT_FILES.values.join('|')} hiçbiri çözümlenmedi)"
      else
        begin
          result = push_play_contact_details(
            options.merge(resolved_details: details, package_name: package_name)
          )
          changes = result[:changes] || {}
          if changes.empty?
            "güncel (değişiklik yok)"
          else
            "güncellendi (#{changes.keys.join(', ')} · #{result[:mode]})"
          end
        rescue => e
          step_errors << "contact details: #{first_line.call(e)}"
          "hata (#{first_line.call(e)})"
        end
      end

    # ③ Data safety — only a USER-provided CSV (option / env / app override)
    # is auto-uploaded. The generic CLI-default template is NEVER pushed by
    # the composite: Google rejects it (400) and it would overwrite a real,
    # hand-filled form with generic answers. When only the template (or
    # nothing) resolves, soft-skip and tell the user to export their own CSV.
    csv = PlaySetupHelpers.resolve_data_safety_csv_path(
      options,
      fastlane_root: FastlaneCliConfig.resolve_fastlane_root(options),
      runner_root: FastlaneCliConfig.resolve_runner_fastlane_path(options),
      base_dir: FastlaneCliConfig.resolve_app_root(options)
    )
    safety_status =
      if !FastlaneCliConfig.bool_option(options, :include_data_safety, default: true)
        "atlandı (include_data_safety=false)"
      elsif !PlaySetupHelpers.user_provided_csv?(csv[:source])
        "atlandı (kendi data_safety.csv'ni ver — Play Console → App content → Data safety → Export)"
      else
        begin
          stats = google_play_data_safety(
            package_name: package_name,
            json_key: FastlaneCliConfig.absolute_json_key(options),
            csv_path: csv[:path]
          )
          "yüklendi (#{csv[:source]} · #{stats[:lines]} satır) — form TAMAMEN bu CSV ile değiştirildi"
        rescue => e
          step_errors << "data safety: #{first_line.call(e)}"
          "hata (#{first_line.call(e)})"
        end
      end

    # The final box ALWAYS prints — even when steps failed — so the user
    # sees exactly which steps landed before the lane errors out.
    FastlaneCliConfig.print_summary_box(
      "Android · Play Console store setup",
      [
        "Package        : #{package_name}",
        "Metadata root  : #{metadata_path}",
        :sep,
        "① Store listing   : #{listing_status}",
        "② Contact details : #{contact_status}",
        "③ Data safety     : #{safety_status}",
        *PlaySetupHelpers.manual_checklist_lines
      ]
    )

    unless step_errors.empty?
      UI.user_error!("store_setup finished with errors — #{step_errors.join(' · ')}")
    end
  end
end
